<?xml version="1.0" encoding="UTF-8"?>

<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">

    <arg name="basepath" value="."/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="50"/>
    <arg value="ps"/>

    <rule ref="PSR12">
        <!-- require and require_once before classes declarations -->
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>

        <!-- namespaces -->
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>

        <!-- some methods are not in camel case (related to SEDA NG) -->
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps"/>

        <exclude name="PSR2.Methods.MethodDeclaration.Underscore"/>

    </rule>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="200"/>
            <property name="absoluteLineLimit" value="200"/>
        </properties>
    </rule>

    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
    <rule ref="Squiz.Arrays.ArrayDeclaration.CloseBraceNewLine"/>
    <rule ref="Squiz.Arrays.ArrayDeclaration.SpaceInEmptyArray"/>
    <rule ref="Squiz.Arrays.ArrayDeclaration.IndexNoNewline"/>

    <file>./action</file>
    <file>./api</file>
    <file>./bin</file>
    <file>./connecteur</file>
    <file>./connecteur-type</file>
    <file>./controler</file>
    <file>./docker</file>
    <file>./lib</file>
    <file>./mailsec</file>
    <file>./model</file>
    <file>./module</file>
    <file>./pastell-core</file>
    <file>./src</file>
    <file>./template</file>
    <file>./test</file>
    <file>./tests</file>
    <file>./type-dossier</file>
    <file>DefaultSettings.php</file>
    <file>init.php</file>
    <file>init-no-db.php</file>

    <exclude-pattern>./extensions/*/vendor</exclude-pattern>
    <exclude-pattern>./extensions/*/build</exclude-pattern>
    <exclude-pattern>./test/codeception/tests/_support/_generated</exclude-pattern>

</ruleset>
