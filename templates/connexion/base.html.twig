<!DOCTYPE html>
<html lang="fr">
<head>
    <title>Connexion - Pastell</title>

    <meta name="description"
          content="Pastell est un logiciel de gestion de flux de documents. Les documents peuvent être crées via un système de formulaires configurables. Chaque document suit alors un workflow prédéfini, également configurable."/>
    <meta name="keywords"
          content="Pastell, collectivité territoriale, flux, document, données, logiciel, logiciel libre, open source"/>
    <meta http-equiv="content-type" content="text/html; charset=utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="chrome=1">

    <base href='{{ constant('SITE_BASE') }}'/>

    <link rel="shortcut icon" type="images/x-icon" href="{{ asset('favicon.ico') }}"/>

    {% set cssFiles = [
        'node_modules/@fortawesome/fontawesome-free/css/all.min.css',
        'node_modules/@libriciel/ls-auth-native/styles.css',
        'node_modules/@libriciel/ls-bootstrap-5/pa-bootstrap.css',
        'node_modules/@libriciel/design-system/styles/design-system-tokens.css',
        'node_modules/@libriciel/ls-jquery-password/dist/css/ls-jquery-password.css',
    ] %}

    {% block stylesheets %}
        {% for cssFile in cssFiles %}
            <link rel="stylesheet" href="{{ cssFile ~ '?rev=' ~ manifest_info.revision }}" type="text/css"/>
        {% endfor %}
    {% endblock %}
</head>

<body>

{% block main %}{% endblock %}

<ls-footer
        variant="login"
        product-name="Pastell"
        product-version="{{ manifest_info.version }}"
        accessibility-href="{{ path('app.legacy.accessibilite_index') }}"
        accessibility-status="partiellement conforme"
></ls-footer>

{% set jsFiles = [
    'node_modules/@libriciel/ls-auth-native/ls-auth.js',
] %}

{% block javascript %}
{% for jsFile in jsFiles %}
    <script type="text/javascript" src="{{ jsFile ~ '?rev=' ~ manifest_info.revision }}"></script>
{% endfor %}
<script type="module" src="{{ 'node_modules/@libriciel/design-system/components/footer/index.js?rev=' ~ manifest_info.revision }}"></script>
{% endblock %}

</body>
</html>
