{% extends 'connexion/base.html.twig' %}

{% block main %}

    <div class="page-height d-flex position-relative">
        <ls-auth-page-sidebar class="sidebar"></ls-auth-page-sidebar>
        <div class="login-form">
            <ls-auth-page-alert></ls-auth-page-alert>
            <div class="form-content">
                <div class="text-center h-100">
                    <img src="{{ asset('img/commun/pastell-color-grey.svg') }}" alt="logo de l'application">
                </div>
                {% if gabarit.getLastError().getLastError() or gabarit.getLastMessage().getLastMessage() %}
                    <ls-forgot-password-success></ls-forgot-password-success>

                    <script>
                        const forgotPasswordSuccessElement = document.getElementsByTagName(
                            "ls-forgot-password-success"
                        )[0];
                        forgotPasswordSuccessElement.addEventListener('backToLogin', function () {
                            window.location = "{{ path('app.legacy.connexion_connexion') }}";
                        });
                    </script>

                {% else %}

                    {% if config and config.get('procedure_recup') %}
                        <div class="forgot-form-addons">
                            <div class="alert alert-info">
                                <i class="fa fa-info-circle"></i>
                                {{ gabarit.getHTMLPurifier.purify(config.get('message'))|raw|nl2br }}
                            </div>
                        </div>
                    {% else %}
                        <ls-forgot-password></ls-forgot-password>
                    {% endif %}
                    <script>
                        const forgotPasswordElement = document.getElementsByTagName("ls-forgot-password")[0];

                        forgotPasswordElement.additionalSubmittedValues = [
                            {name: 'csrf_token', value: '{{ gabarit.getCSRFToken().getCSRFToken() }}', type: 'hidden'},
                        ];

                        forgotPasswordElement.configuration = {
                            formAction: "{{ path('app.legacy.connexion_doOublieIdentifiant') }}",
                            oneFieldForgot: true,
                            oneFieldForgotWithUsernameInputOnly: true,
                            usernameInputName: "login",
                        };

                        forgotPasswordElement.addEventListener('backToLogin', function () {
                            window.location = "{{ path('app.legacy.connexion_connexion') }}";
                        });
                    </script>
                {% endif %}
            </div>
        </div>
    </div>

    <script>
        {% if login_page_configuration != '' %}
            document.getElementsByTagName("ls-auth-page-sidebar")[0].configuration = {{ login_page_configuration | raw }};
            document.getElementsByTagName("ls-auth-page-alert")[0].configuration = {{ login_page_configuration | raw }};
        {% endif %}
    </script>
{% endblock %}
