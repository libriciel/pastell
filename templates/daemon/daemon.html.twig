{% extends 'base.html.twig' %}

{% block main %}
    <div id='daemon-content'>
        {% include 'daemon/daemon_content.html.twig' %}
    </div>

    <script type="text/javascript">
        function reload() {
            let params = new URLSearchParams(window.location.search);
            let id_e = params.get("id_e");
            let id_daemon = params.get("id_daemon");
            let action = "{{ path('app.legacy.entite_daemonContent', { 'id_e': '__IDE__', 'id_daemon': '__IDDAEMON__' })|raw }}"
                .replace('__IDE__', id_e)
                .replace('__IDDAEMON__', id_daemon);
            $("#daemon-content").load(action);
        }

        $(document).ready(function () {
            setInterval(function () {
                reload();
            }, 1000);
        });
    </script>
{% endblock %}