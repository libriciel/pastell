<div class="box">
    <table class='table' aria-label="Gestionnaire de tâches">
        <tr>
            <th class="w300">État</th>
            <td>
                {% if daemon.state %}
                    {% if daemon_edition %}
                        <a href="{{ path('app.legacy.daemon_daemonStop',{'id_daemon': daemon.id_daemon, 'return_url': return_url}) }}" class="btn btn-danger" id="arreter_deamon" name="arreter_deamon">
                            <i class="fas fa-stop"></i>&nbsp; Arrêter
                        </a>
                    {% endif %}
                    <span class="alert alert-success">Le gestionnaire de tâches est actif</span>
                {% else %}
                    {% if daemon_edition %}
                        <a href="{{ path('app.legacy.daemon_daemonStart',  {'id_daemon': daemon.id_daemon, 'return_url': return_url}) }}" class="btn btn-success" id="arreter_deamon" name="arreter_deamon">
                            <i class="fas fa-play"></i>&nbsp; Démarrer
                        </a>
                    {% endif %}
                    <span class="alert alert-danger">Le gestionnaire de tâches est arrêté</span>
                {% endif %}
            </td>
        </tr>
        <tr>
            <th>Processus simultanés maximum</th>
            {% set workers = daemon.nb_workers %}
            <td>{{ workers }}</td>
        </tr>
        <tr>
            <th>Processus en cours d'exécution</th>
            <td>{{ nb_worker_actif }}</td>
        </tr>
        <tr>
            <th>Travaux en attente</th>
            <td>
                {{ job_stat_info.nb_wait }}
            </td>
        </tr>
        <tr>
            <th>Travaux suspendus</th>
            <td>
                {{ job_stat_info.nb_lock }}
                {% if (job_stat_info.nb_lock_one_hour and daemon_global_lecture) %}
                    <span class='alert alert-warning'>
                        <a href="{{ path('app.legacy.entite_job', {'filtre': 'lock',   id_e: daemon.id_e ?? 0 }) }}">
                            {{ job_stat_info.nb_lock_one_hour }} depuis plus d'une heure !
                        </a>
                    </span>
                {% endif %}
            </td>
        </tr>
        <tr>
            <th>Nombre total de travaux</th>
            <td>{{ job_stat_info.nb_job }}</td>
        </tr>
        <tr>
            <th>Date du système</th>
            <td>{{ gabarit.FancyDate.getDateFr() }}</td>
        </tr>

    </table>
</div>

{% include 'daemon/job_list.html.twig' %}
