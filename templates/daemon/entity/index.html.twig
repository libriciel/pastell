{% extends 'base.html.twig' %}

{% block main %}
    <div id='daemon-status'>
        {% include 'daemon/entity/index_status.html.twig' %}
    </div>

    {% include 'daemon/job_search_form.html.twig' %}

    <div id='daemon-jobs'>
        {% include 'daemon/entity/index_jobs.html.twig' %}
    </div>

    <script type="text/javascript">
        function reload() {
            $.get("{{ path('app.legacy.entite_daemonContent') }}" + window.location.search, function (data) {
                let content = $("<div>").html(data);
                $("#daemon-status").html(content.find("#daemon-status-inner"));
                $("#daemon-jobs").html(content.find("#daemon-jobs-inner"));
            });
        }

        $(document).ready(function () {
            setInterval(function () {
                reload();
            }, 1000);
        });
    </script>
{% endblock %}
