<div class="box">
    <h2>Recherche avancée</h2>
    <form method="get" action="{{ path(search_action) }}" class="mb-0">
        {% if id_e is defined %}
            <input type="hidden" name="id_e" value="{{ id_e }}">
        {% endif %}
        <input type="hidden" name="filtre" value="{{ filtre|default('') }}">

        <div class="row g-3 align-items-start">
            <div class="col-md-4 col-lg-2">
                <label class="form-label" for="search-type">Type</label>
                <div class="select2-multiselect-field">
                    <select class="form-select select2-multiselect" id="search-type" name="job_type[]"
                            data-placeholder="Tous" multiple="multiple">
                        {% for type_value, type_label in type_list %}
                            <option value="{{ type_value }}"
                                {{ type_value in search.type ? 'selected' : '' }}>{{ type_label }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="col-md-4 col-lg-3">
                <label class="form-label" for="search-job-status">État</label>
                <div class="select2-multiselect-field">
                    <select class="form-select select2-multiselect" id="search-job-status" name="job_status[]"
                            data-placeholder="Tous" multiple="multiple">
                        {% for status in job_status_list %}
                            <option value="{{ status.value }}"
                                {{ status.value in search.job_status ? 'selected' : '' }}>
                                {{ status.name == 'WAITING' ? status.label() : 'Suspendu - ' ~ status.label() }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="col-md-4 col-lg-2">
                <label class="form-label" for="search-suspended">Suspendu</label>
                <select class="form-select" id="search-suspended" name="suspended">
                    <option value="">Indifférent</option>
                    <option value="oui" {{ search.suspended == 'oui' ? 'selected' : '' }}>Oui</option>
                    <option value="non" {{ search.suspended == 'non' ? 'selected' : '' }}>Non</option>
                </select>
            </div>

            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="search-id-e">Entité</label>
                <input type="hidden" id="search-id-e" name="search_id_e" value="{{ search.id_e }}">
                <div class="treeselect-job-search-entity"></div>
                <script type="application/json" class="treeselect-config">{{ entity_treeselect_config|raw }}</script>
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" value="1"
                           id="search-include-children" name="include_children"
                           {{ search.include_children ? 'checked' : '' }}>
                    <label class="form-check-label" for="search-include-children">
                        Inclure les entités filles
                    </label>
                </div>
            </div>

            <div class="col-md-6 col-lg-2">
                <label class="form-label" for="search-id-verrou">File d'attente</label>
                <div class="select2-multiselect-field">
                    <select class="form-select select2-multiselect" id="search-id-verrou" name="id_verrou[]"
                            data-placeholder="Toutes" multiple="multiple">
                        <option value="{{ verrou_none_value }}"
                            {{ verrou_none_value in search.id_verrou ? 'selected' : '' }}>(vide)</option>
                        {% for verrou in verrou_list %}
                            <option value="{{ verrou }}"
                                {{ verrou in search.id_verrou ? 'selected' : '' }}>{{ verrou }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-magnifying-glass"></i>&nbsp;Rechercher
                </button>
                <a class="btn btn-secondary"
                   href="{{ path(search_action, id_e is defined ? {'id_e': id_e, 'filtre': filtre|default('')} : {'filtre': filtre|default('')}) }}">
                    Réinitialiser
                </a>
            </div>
        </div>
    </form>
</div>
