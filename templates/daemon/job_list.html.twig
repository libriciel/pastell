{% import _self as ui %}

{% macro sort_header(column, sort, search_route, job_query_params) %}
    {% set is_active = sort|default(null) is not null and sort.column.value == column.value %}
    {% set next_dir = (is_active and sort.direction.value == 'desc') ? 'asc' : 'desc' %}
    <a href="{{ path(search_route, job_query_params|merge({'sort_by': column.value, 'sort_dir': next_dir, 'offset': 0})) }}"
       class="text-nowrap text-decoration-none{{ is_active ? ' fw-bold' : '' }}"
       title="Trier par {{ column.label|lower }}">
        {{ column.label }}
        {% if is_active %}
            <i class="fas fa-sort-{{ sort.direction.value == 'asc' ? 'up' : 'down' }}"></i>
        {% else %}
            <i class="fas fa-sort text-muted"></i>
        {% endif %}
    </a>
{% endmacro %}

<div class='box'>
    <h2>
        {{ sub_title }}
    </h2>

    {% if daemon_edition and filtre is defined and filtre == 'lock' %}
        {% if id_e is defined %}
            <a class='btn btn-warning mb-2' href="{{ path(unlock_all_action, {'id_e': id_e}) }}">
        {% else %}
            <a class='btn btn-warning mb-2' href="{{ path(unlock_all_action) }}">
        {% endif %}
            <i class="fas fa-unlock-keyhole"></i>&nbsp;Reprendre l'exécution de tous les travaux
        </a>
    {% endif %}

    <table class="table table-striped">
        <tr>
            <th>#ID travail</th>
            <th>Type</th>
            <th>État</th>
            <th>Entité</th>
            <th>#ID gestionnaire de tâche</th>
            <th>Dossier / Connecteur</th>
            <th>État source<br/>État cible</th>
            <th>{{ ui.sort_header(constant('Pastell\\Model\\Daemon\\JobSortColumn::FIRST_TRY'), sort|default(null), search_route, job_query_params) }}</th>
            <th>{{ ui.sort_header(constant('Pastell\\Model\\Daemon\\JobSortColumn::LAST_TRY'), sort|default(null), search_route, job_query_params) }}</th>
            <th>Nombre d'essais</th>
            <th>Dernier message</th>
            <th>{{ ui.sort_header(constant('Pastell\\Model\\Daemon\\JobSortColumn::NEXT_TRY'), sort|default(null), search_route, job_query_params) }}</th>
            <th>File d'attente</th>
            <th>#ID processus</th>
            <th>PID processus</th>
            <th>Début processus</th>
        </tr>
        {% for job in job_list %}
            <tr>
                <td>
                    <a href="{{ path('app.legacy.daemon_detail', {'id_job': job.id_job}) }}">{{ job.id_job }}</a>
                </td>
                <td>{{ job.type == constant('Job::TYPE_DOCUMENT') ? 'Dossier' : 'Connecteur' }}</td>
                <td>
                    <p>{{ job.getEtatLabel() }}</p>
                    {% if job.job_status !== constant('Pastell\\Configuration\\JobStatus::WAITING') %}
                        <p class='alert alert-danger'>
                            Suspendu depuis le {{ gabarit.FancyDate.getDateFr(job.lock_since) }}
                            {% if  daemon_edition %}
                                <a href="{{ path('app.legacy.daemon_unlock', {'id_job': job.id_job, 'return_url': return_url}) }}"
                                   class="btn-warning btn">
                                    <i class="fas fa-unlock-keyhole"></i>&nbsp;
                                    Reprendre
                                </a>
                            {% endif %}
                        </p>
                    {% else %}
                        {% if  daemon_edition %}
                            <p><a href="{{ path('app.legacy.daemon_lock', {'id_job': job.id_job, 'return_url': return_url}) }}"
                                  class="btn btn-warning">
                                    <i class="fas fa-lock"></i>&nbsp;
                                    Suspendre
                                </a>
                            </p>
                        {% endif %}
                    {% endif %}
                </td>
                <td style="word-break: break-all;">
                    {{ job.entite_denomination }} (<a
                            href="{{ path('app.legacy.entite_detail', {'id_e': job.id_e}) }}">{{ job.id_e }}</a>)
                </td>
                <td>
                    {% if job.daemon is defined %}
                        {{ job.daemon.id_daemon }}
                    {% endif %}
                </td>
                <td style="word-break: break-all;">
                    {% if job.id_d %}
                        {{ job.document_titre }} (<a
                            href="{{ path('app.legacy.document_detail', {'id_e': job.id_e, 'id_d': job.id_d}) }}">{{ job.id_d }}</a>)
                    {% endif %}
                    {% if job.id_ce %}
                        {{ job.connecteur_libelle }}  (<a
                            href="{{ path('app.legacy.connecteur_edition', {'id_ce': job.id_ce}) }}">{{ job.id_ce }}</a>)
                    {% endif %}
                </td>
                <td>{{ job.etat_source }}<br/>{{ job.etat_cible }}</td>
                <td>{{ gabarit.FancyDate.getDateFr(job.first_try) }}</td>
                <td>{{ gabarit.FancyDate.getDateFr(job.last_try) }}</td>
                <td>{{ job.nb_try }}</td>
                <td style="word-break: break-all;">{{ job.last_message }}</td>
                <td>
                    {{ gabarit.FancyDate.getDateFr(job.next_try) }}
                    <br/>{{ gabarit.FancyDate.getTimeElapsed(job.next_try) }}
                </td>
                <td>{{ job.id_verrou }}</td>
                <td>{{ job.worker.id_worker|default('') }}</td>
                <td>
                    {{ job.worker.pid|default('') }}
                    {% if daemon_edition and job.worker.pid|default(false) %}
                        {% if not job.worker.termine|default(false) %}
                            <a href="{{ path('app.legacy.daemon_kill', {'id_worker': job.worker.id_worker|default(''), 'return_url': return_url}) }}"
                               class='btn btn-danger'>
                                <i class="fas fa-bolt"></i>&nbsp;
                                Tuer
                            </a>
                        {% else %}
                            <br/>{{ job.worker.message|default('') }}
                        {% endif %}
                    {% endif %}
                </td>
                <td>
                    {% if job.worker.id_worker|default('') %}
                        {{ gabarit.FancyDate.getDateFr(job.worker.date_begin) }}
                        <br/>{{ gabarit.FancyDate.getTimeElapsed(job.worker.date_begin) }}
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    </table>

    {% if daemon_edition and filtre is defined and filtre == 'lock' %}
        {% if id_e is defined %}
            <a class='btn btn-warning mb-2' href="{{ path(unlock_all_action, {'id_e': id_e}) }}">
        {% else %}
            <a class='btn btn-warning mb-2' href="{{ path(unlock_all_action) }}">
        {% endif %}
            <i class="fas fa-unlock-keyhole"></i>&nbsp;Reprendre l'exécution de tous les travaux
        </a>
    {% endif %}
</div>
