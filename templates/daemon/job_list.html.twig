{% import _self as ui %}

{% macro sort_header(column, sort, search_route, job_query_params, sortable) %}
    {% if not sortable %}
        {{ column.label }}
    {% else %}
        {% set is_active = sort|default(null) is not null and sort.column.value == column.value %}
        {% set next_dir = (is_active and sort.direction.value == 'desc') ? 'asc' : 'desc' %}
        <a href="{{ path(search_route, job_query_params|merge({'sort_by': column.value, 'sort_dir': next_dir, 'offset': 0})) }}"
           class="text-nowrap text-decoration-none{{ is_active ? ' fw-bold' : '' }}"
           title="Trier par {{ column.label|lower }}">
            {{ column.label }}
            {% if is_active %}
                <i class="fas fa-sort-{{ sort.direction.value == 'asc' ? 'up' : 'down' }}"></i>
            {% else %}
                <i class="fas fa-sort text-muted"></i>
            {% endif %}
        </a>
    {% endif %}
{% endmacro %}

<div class='box'>
    <h2>
        {{ sub_title }}
    </h2>

    {% set bulk_enabled = daemon_edition and search is defined and unlock_all_action is defined and lock_all_action is defined %}

    {% if bulk_enabled %}
    <form method="post">
        {{ gabarit.displayCSRFInput() }}
        <input type="hidden" name="return_url" value="{{ return_url }}">
        {% if id_e is defined %}
            <input type="hidden" name="id_e" value="{{ id_e }}">
        {% endif %}
        {# Critères de la recherche affichée #}
        {% for name, values in {'job_type': search.type, 'job_status': search.job_status, 'id_verrou': search.id_verrou} %}
            {% for value in values %}
                <input type="hidden" name="{{ name }}[]" value="{{ value }}">
            {% endfor %}
        {% endfor %}
        {% for name, value in {'search_id_e': search.id_e, 'include_children': search.include_children, 'late': search.late, 'late_before': search.late_before} %}
            <input type="hidden" name="{{ name }}" value="{{ value }}">
        {% endfor %}

        {# nb : travaux de la recherche réellement modifiés par l'action (cf. JobQueueSQL::bulkEligibleCondition()) #}
        {% set search_actions = {
            'lock': {'route': lock_all_action, 'icon': 'fa-lock', 'verb': 'Suspendre', 'label': 'Suspendre les travaux en attente', 'nb': nb_lockable|default(0)},
            'unlock': {'route': unlock_all_action, 'icon': 'fa-unlock-keyhole', 'verb': 'Reprendre', 'label': 'Reprendre les travaux suspendus', 'nb': nb_unlockable|default(0)}
        } %}

        <div class="d-flex flex-wrap gap-2 mb-2">
            {% for action, info in search_actions %}
                <button type="button" class="btn btn-outline-warning"
                        data-bs-toggle="modal" data-bs-target="#job-bulk-modal-{{ action }}"
                        {{ info.nb > 0 ? '' : 'disabled' }}>
                    <i class="fas {{ info.icon }}"></i>&nbsp;{{ info.label }} ({{ info.nb }})
                </button>
            {% endfor %}
        </div>

        {% for action, info in search_actions|filter(info => info.nb > 0) %}
            <div class="modal fade" id="job-bulk-modal-{{ action }}" tabindex="-1"
                 aria-labelledby="job-bulk-modal-{{ action }}-title" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="job-bulk-modal-{{ action }}-title">Confirmation</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                        </div>
                        <div class="modal-body">
                            {{ info.verb }} les travaux correspondant à la recherche ({{ info.nb }} actuellement) ?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Annuler</button>
                            <button type="submit" formaction="{{ path(info.route) }}" class="btn btn-warning">
                                <i class="fas {{ info.icon }}"></i>&nbsp;{{ info.verb }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </form>
    {% endif %}

    <table class="table table-striped">
        <tr>
            <th>#ID travail</th>
            <th>Type</th>
            <th>État</th>
            <th>Entité</th>
            <th>#ID gestionnaire de tâche</th>
            <th>Dossier / Connecteur</th>
            <th>État source<br/>État cible</th>
            <th>{{ ui.sort_header(constant('Pastell\\Model\\Daemon\\JobSortColumn::FIRST_TRY'), sort|default(null), search_route|default(null), job_query_params|default({}), search is defined) }}</th>
            <th>{{ ui.sort_header(constant('Pastell\\Model\\Daemon\\JobSortColumn::LAST_TRY'), sort|default(null), search_route|default(null), job_query_params|default({}), search is defined) }}</th>
            <th>Nombre d'essais</th>
            <th>Dernier message</th>
            <th>{{ ui.sort_header(constant('Pastell\\Model\\Daemon\\JobSortColumn::NEXT_TRY'), sort|default(null), search_route|default(null), job_query_params|default({}), search is defined) }}</th>
            <th>File d'attente</th>
            <th>#ID processus</th>
            <th>PID processus</th>
            <th>Début processus</th>
        </tr>
        {% for job in job_list %}
            <tr>
                <td>
                    <a href="{{ path('app.legacy.daemon_detail', {'id_job': job.id_job}) }}">{{ job.id_job }}</a>
                </td>
                <td>{{ job.type == constant('Job::TYPE_DOCUMENT') ? 'Dossier' : 'Connecteur' }}</td>
                <td>
                    <p>{{ job.getEtatLabel() }}</p>
                    {% if job.job_status !== constant('Pastell\\Configuration\\JobStatus::WAITING') %}
                        <p class='alert alert-danger'>
                            Suspendu depuis le {{ gabarit.FancyDate.getDateFr(job.lock_since) }}
                            {% if  daemon_edition %}
                                <a href="{{ path('app.legacy.daemon_unlock', {'id_job': job.id_job, 'return_url': return_url}) }}"
                                   class="btn-warning btn">
                                    <i class="fas fa-unlock-keyhole"></i>&nbsp;
                                    Reprendre
                                </a>
                            {% endif %}
                        </p>
                    {% else %}
                        {% if  daemon_edition %}
                            <p><a href="{{ path('app.legacy.daemon_lock', {'id_job': job.id_job, 'return_url': return_url}) }}"
                                  class="btn btn-warning">
                                    <i class="fas fa-lock"></i>&nbsp;
                                    Suspendre
                                </a>
                            </p>
                        {% endif %}
                    {% endif %}
                </td>
                <td style="word-break: break-all;">
                    {{ job.entite_denomination }} (<a
                            href="{{ path('app.legacy.entite_detail', {'id_e': job.id_e}) }}">{{ job.id_e }}</a>)
                </td>
                <td>
                    {% if job.daemon is defined %}
                        {{ job.daemon.id_daemon }}
                    {% endif %}
                </td>
                <td style="word-break: break-all;">
                    {% if job.id_d %}
                        {{ job.document_titre }} (<a
                            href="{{ path('app.legacy.document_detail', {'id_e': job.id_e, 'id_d': job.id_d}) }}">{{ job.id_d }}</a>)
                    {% endif %}
                    {% if job.id_ce %}
                        {{ job.connecteur_libelle }}  (<a
                            href="{{ path('app.legacy.connecteur_edition', {'id_ce': job.id_ce}) }}">{{ job.id_ce }}</a>)
                    {% endif %}
                </td>
                <td>{{ job.etat_source }}<br/>{{ job.etat_cible }}</td>
                <td>{{ gabarit.FancyDate.getDateFr(job.first_try) }}</td>
                <td>{{ gabarit.FancyDate.getDateFr(job.last_try) }}</td>
                <td>{{ job.nb_try }}</td>
                <td style="word-break: break-all;">{{ job.last_message }}</td>
                <td>
                    {{ gabarit.FancyDate.getDateFr(job.next_try) }}
                    <br/>{{ gabarit.FancyDate.getTimeElapsed(job.next_try) }}
                </td>
                <td>{{ job.id_verrou }}</td>
                <td>{{ job.worker.id_worker|default('') }}</td>
                <td>
                    {{ job.worker.pid|default('') }}
                    {% if daemon_edition and job.worker.pid|default(false) %}
                        {% if not job.worker.termine|default(false) %}
                            <a href="{{ path('app.legacy.daemon_kill', {'id_worker': job.worker.id_worker|default(''), 'return_url': return_url}) }}"
                               class='btn btn-danger'>
                                <i class="fas fa-bolt"></i>&nbsp;
                                Tuer
                            </a>
                        {% else %}
                            <br/>{{ job.worker.message|default('') }}
                        {% endif %}
                    {% endif %}
                </td>
                <td>
                    {% if job.worker.id_worker|default('') %}
                        {{ gabarit.FancyDate.getDateFr(job.worker.date_begin) }}
                        <br/>{{ gabarit.FancyDate.getTimeElapsed(job.worker.date_begin) }}
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    </table>
</div>
