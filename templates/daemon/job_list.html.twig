<div class='box'>
    <h2>
        {{ sub_title }}
    </h2>

    {% if daemon_edition and filtre is defined and filtre == 'lock' %}
        {% if id_e is defined %}
            <a class='btn btn-warning mb-2' href="{{ path(unlock_all_action, {'id_e': id_e}) }}">
        {% else %}
            <a class='btn btn-warning mb-2' href="{{ path(unlock_all_action) }}">
        {% endif %}
            <i class="fa fa-unlock-alt"></i>&nbsp;Reprendre l'exécution de tous les travaux
        </a>
    {% endif %}

    <table class="table table-striped">
        <tr>
            <th>#ID travail</th>
            <th>Type</th>
            <th>Suspendu</th>
            <th>Entité</th>
            <th>#ID gestionnaire de tâche</th>
            <th>Dossier / Connecteur</th>
            <th>État source<br/>État cible</th>
            <th>Premier essai</th>
            <th>Dernier essai</th>
            <th>Nombre d'essais</th>
            <th>Dernier message</th>
            <th>Prochain essai</th>
            <th>File d'attente</th>
            <th>#ID processus</th>
            <th>PID processus</th>
            <th>Début processus</th>
        </tr>
        {% for job in job_list %}
            <tr>
                <td>
                    <a href="{{ path('app.legacy.daemon_detail', {'id_job': job.id_job}) }}">{{ job.id_job }}</a>
                </td>
                <td>{{ job.type == constant('Job::TYPE_DOCUMENT') ? 'Dossier' : 'Connecteur' }}</td>
                <td>
                    {% if job.is_lock %}
                        <p class='alert alert-danger'>OUI <br/>Depuis
                            le {{ gabarit.FancyDate.getDateFr(job.lock_since) }}
                            {% if  daemon_edition %}
                                <a href="{{ path('app.legacy.daemon_unlock', {'id_job': job.id_job, 'return_url': return_url}) }}"
                                   class="btn-warning btn">
                                    <i class="fa fa-unlock-alt"></i>&nbsp;
                                    Reprendre
                                </a>
                            {% endif %}
                        </p>
                    {% else %}
                        <p>NON
                            {% if  daemon_edition %}
                                <a href="{{ path('app.legacy.daemon_lock', {'id_job': job.id_job, 'return_url': return_url}) }}"
                                   class="btn btn-warning">
                                    <i class="fa fa-lock"></i>&nbsp;
                                    Suspendre</a></p>
                            {% endif %}
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app.legacy.entite_detail', {'id_e': job.id_e}) }}">{{ job.id_e }}</a>
                </td>
                <td>
                    {% if job.daemon is defined %}
                        {{ job.daemon.id_daemon }}
                    {% endif %}
                </td>
                <td>
                    {% if job.id_d %}
                        <a href="{{ path('app.legacy.document_detail', {'id_e': job.id_e, 'id_d': job.id_d}) }}">
                            {{ job.id_d }}
                        </a>
                    {% endif %}
                    {% if job.id_ce %}
                        <a href="{{ path('app.legacy.connecteur_edition', {'id_ce': job.id_ce}) }}">
                            {{ job.id_ce }}
                        </a>
                    {% endif %}
                </td>
                <td>{{ job.etat_source }}<br/>{{ job.etat_cible }}</td>
                <td>{{ gabarit.FancyDate.getDateFr(job.first_try) }}</td>
                <td>{{ gabarit.FancyDate.getDateFr(job.last_try) }}</td>
                <td>{{ job.nb_try }}</td>
                <td>{{ job.last_message }}</td>
                <td>
                    {{ gabarit.FancyDate.getDateFr(job.next_try) }}
                    <br/>{{ gabarit.FancyDate.getTimeElapsed(job.next_try) }}
                </td>
                <td>{{ job.id_verrou }}</td>
                <td>{{ job.worker.id_worker|default('') }}</td>
                <td>
                    {{ job.worker.pid|default('') }}
                    {% if daemon_edition and job.worker.pid|default(false) %}
                        {% if not job.worker.termine|default(false) %}
                            <a href="{{ path('app.legacy.daemon_kill', {'id_worker': job.worker.id_worker|default(''), 'return_url': return_url}) }}"
                               class='btn btn-danger'>
                                <i class="fa fa-bolt"></i>&nbsp;
                                Tuer
                            </a>
                        {% else %}
                            <br/>{{ job.worker.message|default('') }}
                        {% endif %}
                    {% endif %}
                </td>
                <td>
                    {% if job.worker.id_worker|default('') %}
                        {{ gabarit.FancyDate.getDateFr(job.worker.date_begin) }}
                        <br/>{{ gabarit.FancyDate.getTimeElapsed(job.worker.date_begin) }}
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    </table>

    {% if daemon_edition and filtre is defined and filtre == 'lock' %}
        {% if id_e is defined %}
            <a class='btn btn-warning mb-2' href="{{ path(unlock_all_action, {'id_e': id_e}) }}">
        {% else %}
            <a class='btn btn-warning mb-2' href="{{ path(unlock_all_action) }}">
        {% endif %}
            <i class="fa fa-unlock-alt"></i>&nbsp;Reprendre l'exécution de tous les travaux
        </a>
    {% endif %}
</div>
