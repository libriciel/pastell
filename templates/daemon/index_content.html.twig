<div class="box">
    <table class='table' aria-label="Gestionnaire de tâches">
        <tr>
            <th class="w300">État</th>
            <td>
                {% if daemon_pid %}
                    <span class="alert alert-success">Les gestionnaires de tâches sont actifs</span>
                    {% if daemon_edition %}
                        <a href="{{ path('app.legacy.daemon_globalDaemonStop') }}" class="btn btn-danger" id="arreter_deamon" name="arreter_deamon">
                            <i class="fas fa-stop"></i>&nbsp; Tout arrêter
                        </a>
                    {% endif %}
                {% else %}
                    <span class="alert alert-danger">Les gestionnaires de tâches sont arrêtés</span>
                    {% if daemon_edition %}
                        <a href="{{ path('app.legacy.daemon_globalDaemonStart') }}" class="btn btn-success" id="demarrer_daemon" name="demarrer_daemon">
                            <i class="fas fa-play"></i>&nbsp; Tout reprendre
                        </a>
                    {% endif %}
                {% endif %}
            </td>
        </tr>
        <tr>
            <th>PID</th>
            <td>{{ daemon_pid }}</td>
        </tr>
        <tr>
            <th>Processus simultanés maximum</th>
            <td>{{ nb_workers }}</td>
        </tr>
        <tr>
            <th>Processus en cours d'exécution</th>
            <td>
                {% if nb_worker_actif %}
                    <a href="{{ path('app.legacy.daemon_job', {'filtre': 'actif'}) }}">{{ nb_worker_actif }}</a>
                {% else %}
                    {{ nb_worker_actif }}
                {% endif %}
            </td>
        </tr>
        <tr>
            <th>Travaux en retard d'exécution</th>
            <td>
                {% if job_stat_info.nb_wait %}
                    <a href="{{ path('app.legacy.daemon_job', {'job_status': [job_status_waiting], 'late': 1}) }}">{{ job_stat_info.nb_wait }}</a>
                {% else %}
                    {{ job_stat_info.nb_wait }}
                {% endif %}
            </td>
        </tr>
        <tr>
            <th>Travaux suspendus</th>
            <td>
                {% if job_stat_info.nb_lock %}
                    <a href="{{ path('app.legacy.daemon_job', {'job_status': job_status_locked}) }}">{{ job_stat_info.nb_lock }}</a>
                {% else %}
                    {{ job_stat_info.nb_lock }}
                {% endif %}
                {% if (job_stat_info.nb_lock_one_hour and daemon_global_lecture) %}
                    <span class='alert alert-warning'>
                        <a href="{{ path('app.legacy.daemon_job', {'job_status': job_status_locked, 'since_one_hour': 1}) }}">
                            {{ job_stat_info.nb_lock_one_hour }} depuis plus d'une heure !
                        </a>
                    </span>
                {% endif %}
            </td>
        </tr>
        <tr>
            <th>Nombre total de travaux</th>
            <td>
                {% if job_stat_info.nb_job %}
                    <a href="{{ path('app.legacy.daemon_job') }}">{{ job_stat_info.nb_job }}</a>
                {% else %}
                    {{ job_stat_info.nb_job }}
                {% endif %}
            </td>
        </tr>
        <tr>
            <th>Date du système</th>
            <td>{{ gabarit.FancyDate.getDateFr() }}</td>
        </tr>

    </table>
</div>

{% include 'daemon/job_list.html.twig' %}
